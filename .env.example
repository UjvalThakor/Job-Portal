# Copy this file to .env (or export these as real environment variables)
# and fill in values to enable a real AI provider. If left unset, the app
# runs entirely on its built-in rule-based analyzer — no external calls,
# no API costs, fully functional for local dev/demo.

# 'openai', 'gemini', or 'none'
AI_PROVIDER=none

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
